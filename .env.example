# ==============================================================================
# SATELLITE-BRAIN CONFIGURATION BLUEPRINT
# Instructions: Rename this file to '.env' and populate with your cloud keys.
# WARNING: Never commit your actual '.env' file to open-source repositories!
# ==============================================================================

# Google Earth Engine Enterprise Config
EARTHENGINE_PROJECT=your-gee-project-name-here

# Microsoft Planetary Computer (Optional for higher rate-limits)
PLANETARY_COMPUTER_API_KEY=your-microsoft-stac-token-here

# Output Management (Defaults to data/processed/)
SATELLITE_BRAIN_OUTPUT_DIR=data/processed/
